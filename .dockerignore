# Django Ninja Boilerplate - Docker Ignore
# Exclude files from Docker build context for faster builds and smaller images
# ============================================================

# ===========================================
# Docker files (prevent nested context issues)
# ===========================================
# Keep at top for clarity - these must be excluded
Dockerfile*
docker-compose*.yml
.docker/
*.dockerfile

# ===========================================
# Version Control
# ===========================================
.git
.gitignore
.gitattributes
.github/
.gitlab-ci.yml
.travis.yml
azure-pipelines.yml
Jenkinsfile

# ===========================================
# Python Cache & Bytecode
# ===========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.pyo
*.pyd

# ===========================================
# Build & Distribution
# ===========================================
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ===========================================
# Virtual Environments
# ===========================================
.venv/
venv/
ENV/
env/
.env.local
.env.*.local
.uv/

# ===========================================
# IDE and Editor Files
# ===========================================
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/
*.sublime-project
*.sublime-workspace
.spyderproject
.spyproject

# ===========================================
# Testing and Coverage
# ===========================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/
nosetests.xml

# ===========================================
# Type Checking and Linting
# ===========================================
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json
.pytype/

# ===========================================
# Documentation (keep README for build)
# ===========================================
docs/
*.md
!README.md
LICENSE
CHANGELOG*
CONTRIBUTING*

# ===========================================
# Local Development Files
# ===========================================
*.log
*.pot
*.sqlite3
db.sqlite3
.env
.env.*
!.env.example
*.bak
*.backup
local_settings.py

# ===========================================
# Media and Static (generated at runtime)
# ===========================================
media/
staticfiles/
static/admin/
static/collected/

# ===========================================
# Temporary Files
# ===========================================
tmp/
temp/
*.tmp
*.temp
.cache/
*.swp

# ===========================================
# OS Generated Files
# ===========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ===========================================
# Project Specific Exclusions
# ===========================================
# Database dumps and backups
*.sql
*.dump
backups/
dumps/

# Test fixtures (large JSON files)
fixtures/*.json
!fixtures/.gitkeep

# CLI Tool (separate package/build)
cli/

# Scripts not needed in runtime container
scripts/setup.sh
scripts/doctor.sh
scripts/check_data.sh
scripts/*.local.sh

# Deployment configs (not needed inside container)
deploy/
nginx/
kubernetes/
k8s/

# ===========================================
# Large/Binary Files
# ===========================================
*.zip
*.tar
*.tar.gz
*.tar.bz2
*.rar
*.7z
*.iso
*.dmg

# Images (unless specifically needed)
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.svg
!static/images/**

# ===========================================
# Security - Never include these
# ===========================================
*.pem
*.key
*.crt
*.p12
secrets/
credentials/
.secrets
*.secret

# ===========================================
# Misc
# ===========================================
Makefile
*.make
Vagrantfile
.vagrant/
*.box
.pre-commit-config.yaml
.editorconfig
.tool-versions
.python-version
.node-version
.nvmrc
package*.json
yarn.lock
pnpm-lock.yaml
node_modules/
