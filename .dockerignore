# Django Ninja Stack - Docker Ignore
# Exclude files from Docker build context for faster builds

# ===========================================
# Version Control
# ===========================================
.git
.gitignore
.gitattributes

# ===========================================
# Python
# ===========================================
__pycache__
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ===========================================
# Virtual Environments
# ===========================================
.venv
venv/
ENV/
env/
.env.local
.env.*.local

# ===========================================
# IDE and Editor
# ===========================================
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/
*.sublime-project
*.sublime-workspace

# ===========================================
# Testing and Coverage
# ===========================================
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover

# ===========================================
# Type Checking and Linting
# ===========================================
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# ===========================================
# Documentation
# ===========================================
docs/_build/
*.md
!README.md
LICENSE

# ===========================================
# CI/CD
# ===========================================
.github/
.gitlab-ci.yml
.travis.yml
azure-pipelines.yml
Jenkinsfile

# ===========================================
# Docker (avoid nested contexts)
# ===========================================
Dockerfile*
docker-compose*.yml
.docker/

# ===========================================
# Local Development Files
# ===========================================
*.log
*.pot
*.sqlite3
db.sqlite3
.env
.env.local
*.bak

# ===========================================
# Media and Static (generated)
# ===========================================
media/
staticfiles/
static/admin/

# ===========================================
# Temporary Files
# ===========================================
tmp/
temp/
*.tmp
*.temp

# ===========================================
# OS Generated
# ===========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ===========================================
# Project Specific
# ===========================================
*.sql
backups/
fixtures/*.json
!fixtures/.gitkeep

# CLI Tool (separate build)
cli/

# Scripts that aren't needed in container
scripts/setup.sh
scripts/doctor.sh

# ===========================================
# Large Files
# ===========================================
*.zip
*.tar.gz
*.rar
