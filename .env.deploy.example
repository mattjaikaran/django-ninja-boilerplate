# Django Ninja Boilerplate — Deploy Configuration
#
# Copy this file to .env.deploy and fill in your values:
#   cp .env.deploy.example .env.deploy
#
# Only configure the section for your chosen provider.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
DEPLOY_PROVIDER=railway
APP_NAME=my-app

# ---------------------------------------------------------------------------
# Railway (https://railway.app)
# ---------------------------------------------------------------------------
# Get project ID from: railway status (after railway link)
# Or from the Railway dashboard URL: https://railway.app/project/<PROJECT_ID>
RAILWAY_PROJECT_ID=
RAILWAY_SERVICE_ID=

# ---------------------------------------------------------------------------
# Render (https://render.com)
# ---------------------------------------------------------------------------
# Service ID from dashboard: https://dashboard.render.com/web/<SERVICE_ID>
# API key from: https://dashboard.render.com/u/settings#api-keys
RENDER_SERVICE_ID=
RENDER_API_KEY=

# ---------------------------------------------------------------------------
# Fly.io (https://fly.io)
# ---------------------------------------------------------------------------
FLY_APP=
FLY_REGION=iad

# ---------------------------------------------------------------------------
# AWS (ECS / Copilot)
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_CLUSTER=
AWS_SERVICE=
AWS_ECR_REPO=
# Copilot (alternative to ECS direct)
AWS_COPILOT_SVC=api
AWS_COPILOT_ENV=production

# ---------------------------------------------------------------------------
# GCP (Cloud Run)
# ---------------------------------------------------------------------------
GCP_PROJECT=
GCP_REGION=us-central1
GCP_SERVICE=
GCP_IMAGE=

# ---------------------------------------------------------------------------
# VPS / Self-Hosted (Hetzner, DigitalOcean, Linode, etc.)
# ---------------------------------------------------------------------------
DEPLOY_HOST=
DEPLOY_USER=root
DEPLOY_PORT=22
DEPLOY_APP_DIR=/opt/app
DEPLOY_BRANCH=main
COMPOSE_FILE=docker-compose.prod.yml
DEPLOY_PROFILES=
