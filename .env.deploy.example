# Django Ninja Boilerplate — Deploy Configuration
#
# Copy this file to .env.deploy and fill in your values:
#   cp .env.deploy.example .env.deploy
#
# Only configure the section for your chosen provider.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
DEPLOY_PROVIDER=railway
APP_NAME=my-app
# Deploy notification (optional): POST a deploy_complete envelope to a webhook.
# Leave DEPLOY_WEBHOOK_URL empty to skip notifications.
DEPLOY_WEBHOOK_URL=
DEPLOY_ENV=production
FRONTEND_URL=
BACKEND_URL=

# ---------------------------------------------------------------------------
# Required by production settings (api/settings/prod.py)
# ---------------------------------------------------------------------------
# ALLOWED_HOSTS defaults to [] in production, so Django rejects every request
# (400 DisallowedHost) until you set it. Use the real hostnames, comma
# separated, without a scheme. Example: api.example.com,www.example.com
ALLOWED_HOSTS=
# Browser origins allowed to call the API and read CSRF cookies.
# Example: https://example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
# Production requires TLS: cookie auth only works over HTTPS (browsers drop
# Secure cookies on plain HTTP), and api/settings/prod.py refuses to start
# with USE_TLS=false. Terminate TLS at a proxy in front of the bundled nginx
# and have it send X-Forwarded-Proto: https; nginx passes that header through
# to Django. Expose nginx port 80 only to that proxy.
USE_TLS=true
# HSTS is one year with USE_TLS. includeSubDomains and preload are hard to undo
# and break every plain-HTTP subdomain; enable them only when all subdomains
# serve HTTPS.
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
# Admin mount path. Pick an unguessable slug, such as ops-<random>/, and add it
# to the `location ~ ^/(api|admin)/` regex in nginx/nginx.conf.
ADMIN_URL=admin/
# /api/docs and /api/openapi.json: off (default), staff (admin login), public.
API_DOCS=off
# Drives JSON logging and the S3 storage branch in api/settings/common.py.
ENVIRONMENT=production
# JWT access/refresh token signing key. Production (api.settings.prod) refuses
# to start unless this is set and differs from SECRET_KEY.
NINJA_JWT_SIGNING_KEY=

# Required by the Compose `prod` profile (docker-compose.yml). These have no
# defaults: Compose interpolates them into db-prod, valkey-prod, and every
# production Django service. Generate each with `openssl rand -hex 32`.
SECRET_KEY=
DB_NAME=boilerplate_db
DB_USER=postgres
DB_PASSWORD=
REDIS_PASSWORD=

# Proxies that append to X-Forwarded-For in front of Django. Throttles and the
# login lockout read the client IP from it. Too low: every client shares the
# proxy's IP, so 20 failed logins from anyone lock logins for everyone. Too
# high: clients choose their own IP. The prod profile is TLS proxy + bundled
# nginx = 2 (add one per extra hop, such as a CDN). The single/PaaS image
# defaults to 1 (one platform router). See docs/COOKIE_AUTH.md.
NINJA_NUM_PROXIES=2

# Realtime, required by the `realtime-prod` profile. Compose passes these to
# Centrifugo as CENTRIFUGO_TOKEN_HMAC_SECRET_KEY and CENTRIFUGO_API_KEY, and
# Django signs client JWTs with CENTRIFUGO_TOKEN_SECRET, so both sides must
# hold the same secret. api/settings/prod.py refuses to start when either
# value is unset or matches a committed development default. Generate each
# with `openssl rand -hex 32`.
CENTRIFUGO_URL=http://centrifugo-prod:8000
CENTRIFUGO_API_KEY=
CENTRIFUGO_TOKEN_SECRET=
# Browser origins allowed to open a Centrifugo WebSocket, space separated.
# Empty means http://localhost, which matches only the bundled nginx locally.
# Example: https://example.com https://www.example.com
CENTRIFUGO_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Railway (https://railway.app)
# ---------------------------------------------------------------------------
# Get project ID from: railway status (after railway link)
# Or from the Railway dashboard URL: https://railway.app/project/<PROJECT_ID>
RAILWAY_PROJECT_ID=
RAILWAY_SERVICE_ID=

# ---------------------------------------------------------------------------
# Render (https://render.com)
# ---------------------------------------------------------------------------
# Service ID from dashboard: https://dashboard.render.com/web/<SERVICE_ID>
# API key from: https://dashboard.render.com/u/settings#api-keys
RENDER_SERVICE_ID=
RENDER_API_KEY=

# ---------------------------------------------------------------------------
# Fly.io (https://fly.io)
# ---------------------------------------------------------------------------
FLY_APP=
FLY_REGION=iad

# ---------------------------------------------------------------------------
# AWS (ECS / Copilot)
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_CLUSTER=
AWS_SERVICE=
AWS_ECR_REPO=
# Copilot (alternative to ECS direct)
AWS_COPILOT_SVC=api
AWS_COPILOT_ENV=production

# ---------------------------------------------------------------------------
# GCP (Cloud Run)
# ---------------------------------------------------------------------------
GCP_PROJECT=
GCP_REGION=us-central1
GCP_SERVICE=
GCP_IMAGE=

# ---------------------------------------------------------------------------
# VPS / Self-Hosted (Hetzner, DigitalOcean, Linode, etc.)
# ---------------------------------------------------------------------------
DEPLOY_HOST=
DEPLOY_USER=root
DEPLOY_PORT=22
DEPLOY_APP_DIR=/opt/app
DEPLOY_BRANCH=main
COMPOSE_FILE=docker-compose.yml
# Compose profiles the VPS deploy activates (prod is required).
DEPLOY_PROFILES=prod
