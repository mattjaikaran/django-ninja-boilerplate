# Django Ninja Boilerplate Environment Variables
# Copy this file to .env and customize for your environment

# =============================================================================
# Django Core Settings
# =============================================================================
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=1
ENVIRONMENT=development
DJANGO_SETTINGS_MODULE=api.settings

# =============================================================================
# Docker Compose
# =============================================================================
# Every service belongs to a profile, so always pass one explicitly:
#   docker compose --profile dev up -d
# Do NOT set COMPOSE_PROFILES here. Deploys run `--profile prod` in a
# directory that reuses this .env file, and some Compose versions merge the
# two profile sets, which would start the dev services in production.
# The `just` recipes pass --profile for you.
# Profiles: dev, test, prod, single, celery, realtime, realtime-prod,
#           monitoring, observability, huey, django-q, django-rq

# =============================================================================
# Database Settings (PostgreSQL)
# =============================================================================
DB_NAME=boilerplate_db
DB_USER=postgres
DB_PASSWORD=postgres
# These address your machine, not the Docker network: docker-compose.yml pins
# DB_HOST=db for every service, so one .env can serve a host-side run and the
# containerised stack. Starting points in .env are the host values.
DB_HOST=127.0.0.1
DB_PORT=5432
# The settings read the individual DB_* variables above; DATABASE_URL is not
# read by this project.

# =============================================================================
# Valkey/Redis Settings
# =============================================================================
# Valkey is the default (wire-compatible Redis fork, BSD license)
# CACHE_BACKEND options: vcache (Rust-based, default), valkey, redis
CACHE_BACKEND=vcache
VALKEY_URL=valkey://127.0.0.1:6379/0
# REDIS_URL is kept as a fallback alias
REDIS_URL=valkey://127.0.0.1:6379/0
REDIS_PASSWORD=

# =============================================================================
# Task Queue Settings
# =============================================================================
# TASK_BACKEND options: celery (default), huey, django_q, django_rq, dramatiq
TASK_BACKEND=celery
HUEY_IMMEDIATE=false
# kombu has no valkey transport, so use the redis:// scheme against Valkey
# (wire-compatible). Compose pins this for each service.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
# Flower (Celery monitoring UI): set this to your Flower dashboard URL to
# show the "Flower (Celery)" link in the admin. The link stays hidden when
# unset. `docker compose --profile monitoring up flower` exposes it at
# http://localhost:5555.
# FLOWER_URL=http://localhost:5555

# =============================================================================
# API Key Authentication
# =============================================================================
API_KEY_AUTH_ENABLED=True

# =============================================================================
# Decisions App (System One decision engine)
# =============================================================================
# Provider: laya (open-source default), clm (GPU), jev (hosted), fake (tests)
SYSTEMONE_PROVIDER=laya
# Host-side CLM address. Compose pins its internal service URL separately.
CLM_BASE_URL=http://127.0.0.1:8700
# Optional shared key for the CLM API and its callers
CLM_API_KEY=
# Override only for a remote CLM server reachable from Compose containers.
CLM_CONTAINER_URL=
# Optional Hugging Face access token for Qwen3-8B download on a GPU host.
HF_TOKEN=
# Hosted TypeSafe ("Jev") API key; leave unset for local providers.
TYPESAFE_API_KEY=
# Register the /decisions controller. Keep false in production.
ENABLE_DECISIONS=true
# Expose the decisions MCP tools (requires django-ai-boost)
ENABLE_DECISION_MCP=false
# Memory limit for the dev `django` container. The first Laya decision peaked
# near 3.1 GiB with the runserver reloader, so 1G was OOM-killed.
DJANGO_DEV_MEMORY_LIMIT=4G
# Results below this aggregate confidence are flagged for escalation
DECISION_ESCALATION_THRESHOLD=0.5

# =============================================================================
# Frontend & CORS Settings
# =============================================================================
FRONTEND_URL=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,django
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# =============================================================================
# Security Settings
# =============================================================================
USE_TLS=False

# =============================================================================
# JWT Settings
# =============================================================================
# Signing key for JWT access/refresh tokens. Keep it distinct from SECRET_KEY:
# production refuses to start unless this is set and differs from SECRET_KEY.
# Development and tests fall back to SECRET_KEY when unset.
NINJA_JWT_SIGNING_KEY=your-jwt-signing-key-here-change-in-production

# =============================================================================
# Email Settings
# =============================================================================
# Backends:
#   django.core.mail.backends.console.EmailBackend  (dev default)
#   core.services.email.backends.ResendEmailBackend  (native Resend SDK)
#   anymail.backends.resend.EmailBackend             (django-anymail)
# To catch mail in Mailhog (`just up-mail`, UI on http://localhost:8025), set:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=mailhog
#   EMAIL_PORT=1025
#   EMAIL_USE_TLS=False
# then run `just up-mail` (or `just dev` if Mailhog already runs).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com
RESEND_API_KEY=re_your_api_key_here

# =============================================================================
# Superuser Settings (for automatic creation)
# =============================================================================
# createsuperuser  = default django command
# create_superuser = custom command (core/management/commands/create_superuser.py)
# The container entrypoint creates this superuser only when you opt in, so a
# deployment reusing this file cannot provision a known admin account.
# `just setup` creates it explicitly instead.
# CREATE_SUPERUSER=true
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_USERNAME=admin
SUPERUSER_PASSWORD=Password123!
SUPERUSER_FIRST_NAME=Admin
SUPERUSER_LAST_NAME=User

# =============================================================================
# Centrifugo (Real-Time Messaging) — Optional
# =============================================================================
# Development defaults so the realtime stack starts without extra setup.
# Replace both secrets in production: Compose passes them to Centrifugo as
# CENTRIFUGO_TOKEN_HMAC_SECRET_KEY and CENTRIFUGO_API_KEY.
CENTRIFUGO_URL=http://centrifugo:8000
CENTRIFUGO_API_KEY=dev-centrifugo-api-key
CENTRIFUGO_TOKEN_SECRET=dev-centrifugo-token-secret
CENTRIFUGO_TOKEN_TTL=3600

# =============================================================================
# AWS S3 Storage — Optional
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# =============================================================================
# Stripe Payment Integration — Optional
# =============================================================================
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# =============================================================================
# OAuth / Social Auth — Optional
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# =============================================================================
# Third-Party API Keys — Optional
# =============================================================================
OPENAI_API_KEY=
SENTRY_DSN=

# =============================================================================
# Monitoring & Observability — Optional
# =============================================================================
# Flower runs as part of `just up-full` or `just up-monitoring`.
# FLOWER_BASIC_AUTH is the only effective var (user:password format).
# Defaults to admin:password when unset. FLOWER_USER/FLOWER_PASSWORD are
# legacy and no longer read by docker-compose.
FLOWER_BASIC_AUTH=
FLOWER_USER=admin
FLOWER_PASSWORD=password

# =============================================================================
# Service toggles (docker compose profiles)
# =============================================================================
# Core stack (default):   db, valkey, django               -> just up
# Everything:             core + celery, monitoring, realtime
#                                                          -> just up-full
# Celery workers:         core + celery-worker, beat      -> just up-celery
# Monitoring:             core + jaeger, flower           -> just up-monitoring
# Realtime:               core + centrifugo               -> just up-realtime
#
# NOTE: this file holds the values that address your machine. Compose pins the
# container equivalents inside docker-compose.yml (DB_HOST=db, VALKEY_URL and
# REDIS_URL to the valkey service, the OTEL endpoint), so one .env serves both
# a host-side run and the containerised stack.

# =============================================================================
# Host Ports and Production Tuning — Optional
# =============================================================================
# Host ports for the compose stacks. The defaults are offset from 5432/6379
# so the Docker stack runs beside a local Postgres or Redis, which is the
# common case and the reason `just setup` otherwise fails with a port error.
# The application talks to these services over the compose network, so the
# host ports only matter when you connect from outside Docker.
POSTGRES_PORT=5433
VALKEY_PORT=6380
# Published host port for the `single` profile and the PaaS image.
PORT=8000
# Gunicorn workers and Celery concurrency in the prod stack.
GUNICORN_WORKERS=4
CELERY_CONCURRENCY=4
# OpenTelemetry. Set OTEL_ENABLED=true to export traces; Compose points the dev
# `django` service at the `jaeger` service (`just up-monitoring`, UI on
# http://localhost:16686). USE_STRUCTURED_LOGGING defaults to true when
# ENVIRONMENT=production.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=django-ninja-app
USE_STRUCTURED_LOGGING=false
# `just test-integration` offsets these again so it can run beside the dev
# stack as well as a local Postgres and Valkey.
TEST_POSTGRES_PORT=5434
TEST_VALKEY_PORT=6381

# =============================================================================
# Admin Panel Customization
# =============================================================================
ADMIN_SITE_HEADER=Django Ninja Boilerplate Admin
ADMIN_SITE_TITLE=Django Ninja Boilerplate Panel
ADMIN_INDEX_TITLE=Welcome to Django Ninja Boilerplate Panel
