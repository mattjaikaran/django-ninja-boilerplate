# Django Ninja Boilerplate Environment Variables
# Copy this file to .env and customize for your environment

# =============================================================================
# Django Core Settings
# =============================================================================
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=1
ENVIRONMENT=development
DJANGO_SETTINGS_MODULE=api.settings

# =============================================================================
# Database Settings (PostgreSQL)
# =============================================================================
DB_NAME=boilerplate_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432
# Alternative: Use DATABASE_URL instead of individual settings
# DATABASE_URL=postgres://postgres:postgres@db:5432/boilerplate_db

# =============================================================================
# Valkey/Redis Settings
# =============================================================================
# Valkey is the default (wire-compatible Redis fork, BSD license)
# CACHE_BACKEND options: vcache (Rust-based, default), valkey, redis
CACHE_BACKEND=vcache
VALKEY_URL=valkey://valkey:6379/0
# REDIS_URL is kept as a fallback alias
REDIS_URL=valkey://valkey:6379/0
REDIS_PASSWORD=

# =============================================================================
# Task Queue Settings
# =============================================================================
# TASK_BACKEND options: celery (default), huey, django_q, django_rq
TASK_BACKEND=celery
CELERY_BROKER_URL=valkey://valkey:6379/0
CELERY_RESULT_BACKEND=valkey://valkey:6379/0

# =============================================================================
# API Key Authentication
# =============================================================================
API_KEY_AUTH_ENABLED=True

# =============================================================================
# Frontend & CORS Settings
# =============================================================================
FRONTEND_URL=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,django
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# =============================================================================
# Security Settings
# =============================================================================
USE_TLS=False

# =============================================================================
# JWT Settings
# =============================================================================
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME=5
JWT_REFRESH_TOKEN_LIFETIME=1

# =============================================================================
# Email Settings
# =============================================================================
# Backends:
#   django.core.mail.backends.console.EmailBackend  (dev default)
#   core.services.email.backends.ResendEmailBackend  (native Resend SDK)
#   anymail.backends.resend.EmailBackend             (django-anymail)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com
RESEND_API_KEY=re_your_api_key_here

# =============================================================================
# Superuser Settings (for automatic creation)
# =============================================================================
# createsuperuser  = default django command
# create_superuser = custom command (core/management/commands/create_superuser.py)
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_USERNAME=admin
SUPERUSER_PASSWORD=Password123!
SUPERUSER_FIRST_NAME=Admin
SUPERUSER_LAST_NAME=User

# =============================================================================
# Centrifugo (Real-Time Messaging) — Optional
# =============================================================================
# CENTRIFUGO_URL=http://centrifugo:8000
# CENTRIFUGO_API_KEY=your-centrifugo-api-key
# CENTRIFUGO_TOKEN_SECRET=your-centrifugo-token-secret
# CENTRIFUGO_TOKEN_TTL=3600

# =============================================================================
# AWS S3 Storage — Optional
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# =============================================================================
# Stripe Payment Integration — Optional
# =============================================================================
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# =============================================================================
# OAuth / Social Auth — Optional
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# =============================================================================
# Third-Party API Keys — Optional
# =============================================================================
OPENAI_API_KEY=
SENTRY_DSN=

# =============================================================================
# Monitoring & Observability — Optional
# =============================================================================
FLOWER_USER=admin
FLOWER_PASSWORD=password

# =============================================================================
# Admin Panel Customization
# =============================================================================
ADMIN_SITE_HEADER=Django Ninja Boilerplate Admin
ADMIN_SITE_TITLE=Django Ninja Boilerplate Panel
ADMIN_INDEX_TITLE=Welcome to Django Ninja Boilerplate Panel
