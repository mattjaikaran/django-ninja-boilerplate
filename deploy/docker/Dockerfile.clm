# The CLM server runs alongside a separate GPU-backed Qwen3-8B vLLM encoder.
# The published CLM package includes its projection heads and serving CLI.
FROM vllm/vllm-openai:v0.11.2

RUN curl -LsSf https://astral.sh/uv/install.sh -o /tmp/uv-install.sh \
    && sh /tmp/uv-install.sh \
    && rm /tmp/uv-install.sh \
    && /root/.local/bin/uv pip install --system --no-cache 'contrastive-lm==0.1.0'

ENV CLM_CKPT_DIR=/root/.cache/clm \
    CLM_DEVICE=cpu

ENTRYPOINT ["clm-serve"]
CMD ["--host", "0.0.0.0", "--port", "8700", "--emb-url", "http://clm-encoder:8090/v1/embeddings", "--no-ui"]
