# CLM API: the projection heads and the /v1/systemone server. It needs no GPU
# and no vLLM: the Qwen3-8B encoder runs elsewhere (the GPU `clm-encoder`
# service, or llama.cpp on the host with `just clm-encoder-local`), and this
# image only calls it over HTTP. `contrastive-lm` declares vllm as a
# dependency but never imports it, so it is installed with --no-deps next to
# the packages it does import. The result is a small multi-arch CPU image.
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.9 /uv /usr/local/bin/uv

RUN uv pip install --system --no-cache \
        --index-url https://download.pytorch.org/whl/cpu torch==2.14.0 \
    && uv pip install --system --no-cache \
        'numpy==2.5.3' 'requests==2.34.2' 'huggingface-hub==0.36.2' \
        'uvicorn==0.53.0' 'fastapi>=0.115,<1' \
    && uv pip install --system --no-cache --no-deps 'contrastive-lm==0.1.0'

# clm-serve reads CLM_EMB_URL as the --emb-url default, so Compose can point
# the API at the GPU encoder service or at an encoder outside Compose.
ENV CLM_CKPT_DIR=/root/.cache/clm \
    CLM_DEVICE=cpu \
    CLM_EMB_URL=http://clm-encoder:8090/v1/embeddings

ENTRYPOINT ["clm-serve"]
CMD ["--host", "0.0.0.0", "--port", "8700", "--no-ui"]
