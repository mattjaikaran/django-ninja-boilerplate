# Django Ninja Boilerplate - Single Container Production Dockerfile
# Combines Django backend serving via Gunicorn
# Suitable for PaaS deployments (Railway, Render, Fly.io)

# ===========================================
# Stage 1: Build Stage
# ===========================================
FROM python:3.13-slim AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install UV. Download then run, so no pipe is involved.
RUN curl -LsSf https://astral.sh/uv/install.sh -o /tmp/uv-install.sh \
    && sh /tmp/uv-install.sh \
    && rm -f /tmp/uv-install.sh
ENV PATH="/root/.local/bin:$PATH"

# Set working directory
WORKDIR /app

# Copy dependency files
COPY pyproject.toml uv.lock* README.md ./

# Install production dependencies from the lock so the image matches uv.lock
# instead of resolving fresh (a fresh resolve can pick a different Django).
RUN UV_PROJECT_ENVIRONMENT=/opt/venv uv sync --locked --no-dev --no-install-project

# Install the project itself. --no-deps keeps the locked set intact; the
# application source is copied into /app in a later layer.
ENV VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:/root/.local/bin:$PATH"
RUN uv pip install --no-cache --no-deps -e .

# ===========================================
# Stage 2: Production Stage
# ===========================================
FROM python:3.13-slim AS production

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create non-root user
RUN useradd --create-home --shell /bin/bash app

# Set environment variables.
# ENVIRONMENT=production drives the JSON logging and S3 storage branches in
# api/settings/common.py, so it must match the DJANGO_SETTINGS_MODULE here.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    DJANGO_SETTINGS_MODULE=api.settings.prod \
    ENVIRONMENT=production \
    PATH="/opt/venv/bin:$PATH" \
    PORT=8000

# Set working directory
WORKDIR /app

# Copy the virtual environment built from the lock
COPY --from=builder /opt/venv /opt/venv

RUN mkdir -p /app/logs /app/staticfiles /app/media && chown -R app:app /app

# Copy application code
COPY --chown=app:app . .

# Switch to non-root user
USER app

# Collect static files. Importing settings needs these env vars; placeholders
# are passed inline so they are not baked into the image.
RUN SECRET_KEY=build-time-placeholder \
    DB_NAME=build DB_USER=build DB_PASSWORD=build DB_HOST=build DB_PORT=5432 \
    python manage.py collectstatic --noinput

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD ["curl", "-f", "http://localhost:8000/api/health/"]

# Run migrations, then start Gunicorn. The single-container stack owns its
# database, so migrations run at startup; the image is used by PaaS platforms
# that override CMD, which is why this lives in the image and not in compose.
CMD ["sh", "-c", "python manage.py migrate --noinput && exec gunicorn api.wsgi:application --bind 0.0.0.0:8000 --workers 2 --threads 4 --worker-class gthread --worker-tmp-dir /dev/shm --access-logfile - --error-logfile - --capture-output --enable-stdio-inheritance"]
