{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/docker/Dockerfile.single"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "python manage.py migrate --noinput && gunicorn api.asgi:application",
    "healthcheckPath": "/api/health/",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
