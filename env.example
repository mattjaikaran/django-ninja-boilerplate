# Django Ninja Boilerplate Environment Variables
# Copy this file to .env and customize for your environment

# =============================================================================
# Django Core Settings
# =============================================================================
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=1
ENVIRONMENT=development
DJANGO_SETTINGS_MODULE=api.settings

# =============================================================================
# Database Settings (PostgreSQL)
# =============================================================================
DB_NAME=boilerplate_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432
# Alternative: Use DATABASE_URL instead of individual settings
# DATABASE_URL=postgres://postgres:postgres@db:5432/boilerplate_db

# =============================================================================
# Redis Settings
# =============================================================================
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# =============================================================================
# Celery Settings (Background Tasks)
# =============================================================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# =============================================================================
# Frontend & CORS Settings
# =============================================================================
FRONTEND_URL=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,django
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# =============================================================================
# Security Settings
# =============================================================================
USE_TLS=False
# Production security (uncomment in production)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# =============================================================================
# Email Settings
# =============================================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

# Production email (example with SendGrid)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-sendgrid-api-key

# =============================================================================
# Superuser Settings (for automatic creation)
# =============================================================================
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_USERNAME=admin
SUPERUSER_PASSWORD=Password123!
SUPERUSER_FIRST_NAME=Admin
SUPERUSER_LAST_NAME=User

# =============================================================================
# AWS S3 Storage (Optional - for production media files)
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# =============================================================================
# Stripe Payment Integration (Optional)
# =============================================================================
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# =============================================================================
# PayPal Payment Integration (Optional)
# =============================================================================
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# =============================================================================
# OAuth / Social Auth (Optional)
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# =============================================================================
# Third-Party API Keys (Optional)
# =============================================================================
OPENAI_API_KEY=
SENTRY_DSN=

# =============================================================================
# Monitoring & Observability (Optional)
# =============================================================================
# Flower (Celery monitoring)
FLOWER_USER=admin
FLOWER_PASSWORD=password

# =============================================================================
# Admin Panel Customization
# =============================================================================
ADMIN_SITE_HEADER=Django Ninja Boilerplate Admin
ADMIN_SITE_TITLE=Django Ninja Boilerplate Panel
ADMIN_INDEX_TITLE=Welcome to Django Ninja Boilerplate Panel
