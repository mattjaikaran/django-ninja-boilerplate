{
  "Django Model": {
    "prefix": "djmodel",
    "body": [
      "class ${1:ModelName}(models.Model):",
      "    \"\"\"${2:Model description}.\"\"\"",
      "    ",
      "    ${3:field_name} = models.${4:CharField}(${5:max_length=255})",
      "    created_at = models.DateTimeField(auto_now_add=True)",
      "    updated_at = models.DateTimeField(auto_now=True)",
      "    ",
      "    class Meta:",
      "        verbose_name = \"${6:$1}\"",
      "        verbose_name_plural = \"${7:$1s}\"",
      "        ordering = [\"-created_at\"]",
      "    ",
      "    def __str__(self):",
      "        return str(self.${8:field_name})",
      "    ",
      "    def get_absolute_url(self):",
      "        return reverse(\"${9:model_detail}\", kwargs={\"pk\": self.pk})"
    ],
    "description": "Django model template"
  },
  "Django Ninja Controller": {
    "prefix": "djcontroller",
    "body": [
      "from django_ninja_extra import api_controller, http_get, http_post, http_put, http_delete",
      "from django.shortcuts import get_object_or_404",
      "from typing import List",
      "",
      "from ${1:app}.models import ${2:Model}",
      "from ${1:app}.schemas import ${2:Model}Schema, ${2:Model}CreateSchema",
      "",
      "",
      "@api_controller(\"/${3:models}/\", tags=[\"${4:Models}\"])",
      "class ${2:Model}Controller:",
      "    \"\"\"${2:Model} API endpoints.\"\"\"",
      "",
      "    @http_get(\"/\", response=List[${2:Model}Schema])",
      "    def list_${5:models}(self):",
      "        \"\"\"List all ${5:models}.\"\"\"",
      "        return ${2:Model}.objects.all()",
      "",
      "    @http_get(\"/{${6:model}_id}/\", response=${2:Model}Schema)",
      "    def get_${6:model}(self, ${6:model}_id: int):",
      "        \"\"\"Get a specific ${6:model}.\"\"\"",
      "        return get_object_or_404(${2:Model}, id=${6:model}_id)",
      "",
      "    @http_post(\"/\", response=${2:Model}Schema)",
      "    def create_${6:model}(self, payload: ${2:Model}CreateSchema):",
      "        \"\"\"Create a new ${6:model}.\"\"\"",
      "        return ${2:Model}.objects.create(**payload.dict())",
      "",
      "    @http_put(\"/{${6:model}_id}/\", response=${2:Model}Schema)",
      "    def update_${6:model}(self, ${6:model}_id: int, payload: ${2:Model}CreateSchema):",
      "        \"\"\"Update a ${6:model}.\"\"\"",
      "        ${6:model} = get_object_or_404(${2:Model}, id=${6:model}_id)",
      "        for attr, value in payload.dict().items():",
      "            setattr(${6:model}, attr, value)",
      "        ${6:model}.save()",
      "        return ${6:model}",
      "",
      "    @http_delete(\"/{${6:model}_id}/\")",
      "    def delete_${6:model}(self, ${6:model}_id: int):",
      "        \"\"\"Delete a ${6:model}.\"\"\"",
      "        ${6:model} = get_object_or_404(${2:Model}, id=${6:model}_id)",
      "        ${6:model}.delete()",
      "        return {\"success\": True}"
    ],
    "description": "Django Ninja controller template"
  },
  "Django Ninja Schema": {
    "prefix": "djschema",
    "body": [
      "from ninja import ModelSchema",
      "from pydantic import Field",
      "from typing import Optional",
      "from datetime import datetime",
      "",
      "from ${1:app}.models import ${2:Model}",
      "",
      "",
      "class ${2:Model}Schema(ModelSchema):",
      "    \"\"\"${2:Model} response schema.\"\"\"",
      "    ",
      "    class Meta:",
      "        model = ${2:Model}",
      "        fields = \"__all__\"",
      "",
      "",
      "class ${2:Model}CreateSchema(ModelSchema):",
      "    \"\"\"${2:Model} create/update schema.\"\"\"",
      "    ",
      "    class Meta:",
      "        model = ${2:Model}",
      "        fields = [${3:\"field1\", \"field2\"}]"
    ],
    "description": "Django Ninja schema template"
  },
  "Factory Boy Factory": {
    "prefix": "djfactory",
    "body": [
      "import factory",
      "from faker import Faker",
      "",
      "from ${1:app}.models import ${2:Model}",
      "",
      "fake = Faker()",
      "",
      "",
      "class ${2:Model}Factory(factory.django.DjangoModelFactory):",
      "    \"\"\"Factory for creating ${2:Model} instances.\"\"\"",
      "",
      "    class Meta:",
      "        model = ${2:Model}",
      "",
      "    ${3:field_name} = factory.Faker(\"${4:word}\")",
      "    ${5:created_by} = factory.SubFactory(${6:UserFactory})",
      "    ${7:updated_by} = factory.SelfAttribute(\"${5:created_by}\")"
    ],
    "description": "Factory Boy factory template"
  },
  "Pytest Test Class": {
    "prefix": "pytestclass",
    "body": [
      "import pytest",
      "from django.test import Client",
      "",
      "from ${1:app}.tests.factories import ${2:Model}Factory",
      "from ${3:core}.tests.factories import UserFactory",
      "",
      "",
      "@pytest.mark.django_db",
      "class Test${2:Model}API:",
      "    \"\"\"Test ${2:Model} API endpoints.\"\"\"",
      "",
      "    @pytest.fixture",
      "    def api_client(self):",
      "        return Client()",
      "",
      "    @pytest.fixture",
      "    def user(self):",
      "        return UserFactory()",
      "",
      "    @pytest.fixture",
      "    def ${4:model}(self, user):",
      "        return ${2:Model}Factory(created_by=user)",
      "",
      "    def test_create_${4:model}(self, api_client, user):",
      "        \"\"\"Test creating a ${4:model}.\"\"\"",
      "        data = {${5:\"field\": \"value\"}}",
      "        response = api_client.post(",
      "            \"/api/${6:models}/\",",
      "            data,",
      "            content_type=\"application/json\"",
      "        )",
      "        assert response.status_code == 201",
      "",
      "    def test_list_${6:models}(self, api_client, ${4:model}):",
      "        \"\"\"Test listing ${6:models}.\"\"\"",
      "        response = api_client.get(\"/api/${6:models}/\")",
      "        assert response.status_code == 200",
      "        assert len(response.json()) == 1"
    ],
    "description": "Pytest test class template"
  },
  "Django Management Command": {
    "prefix": "djcommand",
    "body": [
      "from django.core.management.base import BaseCommand",
      "from django.utils import timezone",
      "",
      "",
      "class Command(BaseCommand):",
      "    \"\"\"${1:Command description}.\"\"\"",
      "",
      "    help = \"${2:Help text}\"",
      "",
      "    def add_arguments(self, parser):",
      "        parser.add_argument(",
      "            \"${3:argument}\",",
      "            type=str,",
      "            help=\"${4:Argument help text}\"",
      "        )",
      "",
      "    def handle(self, *args, **options):",
      "        ${3:argument} = options[\"${3:argument}\"]",
      "        ",
      "        self.stdout.write(",
      "            self.style.SUCCESS(f\"${5:Success message}: {${3:argument}}\")",
      "        )"
    ],
    "description": "Django management command template"
  }
}
