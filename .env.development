# Django Ninja Boilerplate - Development Environment
# This file contains sensible defaults for local development
# Copy to .env and customize as needed: cp .env.development .env
#
# NOTE: This file is committed to the repository.
# Do NOT put secrets or production values here.
# Use .env (gitignored) for local overrides and secrets.

# ===========================================
# Django Settings
# ===========================================
DEBUG=1
DJANGO_SETTINGS_MODULE=api.settings

# SECRET_KEY will be auto-generated during setup
# Override in .env if needed
SECRET_KEY=development-secret-key-change-in-production

# Allowed hosts for development
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,django

# ===========================================
# Database Settings (PostgreSQL)
# ===========================================
DB_NAME=boilerplate_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# For local development without Docker:
# DB_HOST=localhost

# ===========================================
# Redis Settings
# ===========================================
REDIS_URL=redis://redis:6379/0

# For local development without Docker:
# REDIS_URL=redis://localhost:6379/0

# ===========================================
# Frontend Settings
# ===========================================
FRONTEND_URL=http://localhost:3000

# ===========================================
# CORS Settings
# ===========================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===========================================
# CSRF Settings
# ===========================================
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000

# ===========================================
# JWT Settings
# ===========================================
JWT_SECRET_KEY=development-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME=5
JWT_REFRESH_TOKEN_LIFETIME=1

# ===========================================
# Superuser Settings (for automatic creation)
# ===========================================
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_USERNAME=admin
SUPERUSER_PASSWORD=admin123
SUPERUSER_FIRST_NAME=Admin
SUPERUSER_LAST_NAME=User

# ===========================================
# Email Settings (Resend - console fallback in dev)
# ===========================================
# Set RESEND_API_KEY to enable Resend email delivery.
# When unset, falls back to console backend (prints to stdout).
# RESEND_API_KEY=re_xxxxxxxxxxxx
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ===========================================
# Celery Settings
# ===========================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ===========================================
# Flower Settings (Celery Monitoring)
# ===========================================
FLOWER_BASIC_AUTH=admin:admin

# ===========================================
# Storage Settings (Local for development)
# ===========================================
# For AWS S3 in production, set these in .env:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=DEBUG
